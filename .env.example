# Firebase → Configurações do projeto → Seus apps → App da Web → Configuração do SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Assinatura (opcional; sem isto o Pro fica liberado para todos) ----
# "1" liga a cobrança: depois do teste de 14 dias, Pro só para assinantes.
NEXT_PUBLIC_BILLING_ENABLED=
# Endereço público do site (volta do pagamento), ex: https://margem-swart.vercel.app
NEXT_PUBLIC_SITE_URL=
# Mercado Pago › Suas integrações › Credenciais de produção › Access token
MP_ACCESS_TOKEN=
# ---- Google Agenda (opcional; ver docs/09-ligar-google-agenda.md) ----
# Google Cloud › APIs e serviços › Credenciais › ID do cliente OAuth (Web). Os dois com o mesmo valor.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (O Google Agenda também precisa do FIREBASE_SERVICE_ACCOUNT abaixo.)

# Firebase › Configurações do projeto › Contas de serviço › Gerar nova chave privada (o JSON inteiro, numa linha)
FIREBASE_SERVICE_ACCOUNT=

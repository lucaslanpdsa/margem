rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só lê e escreve os próprios dados.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Situação da assinatura: o usuário só lê; quem grava é o servidor (Firebase Admin ignora estas regras).
    match /billing/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Acesso ao Google Agenda (refresh token): só o servidor lê e grava.
    match /agenda/{uid} {
      allow read, write: if false;
    }
  }
}
